+const metrics=await worker.fetch(new Request('https://fixture.example/api/operator/page-views',{headers}),env,ctx);assert.equal(metrics.status,200);assert.equal((await metrics.json()).days.length,7);checks++;
+const broken={BUCKET:{async list(){return {objects:[]}},put(){throw Error('unavailable')}}};const failed=[];
+const html=await worker.fetch(new Request('https://fixture.example/'),broken,{waitUntil(p){failed.push(p)}});assert.equal(html.status,200);await Promise.all(failed);checks++;
+const privacy=await(await worker.fetch(new Request('https://fixture.example/privacy'),{},{})).text();assert.match(privacy,/anonymous public-page GET events/);assert.match(privacy,/not unique visitors/);checks++;
