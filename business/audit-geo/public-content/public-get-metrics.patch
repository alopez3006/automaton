+++ b/worker/page-views.mjs
@@ -0,0 +1,44 @@
+// Immutable anonymous GET events avoid lost increments under concurrent traffic.
+export const publicPages = Object.freeze({'/':'home','/seo-geo-audit':'guide-audit','/ai-search-visibility':'guide-visibility','/privacy':'privacy'});
+const prefix='metrics/public-get/';
+const dayFormat=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Zurich',year:'numeric',month:'2-digit',day:'2-digit'});
+const day=date=>dayFormat.format(date);
+const offsetDay=(now,offset)=>new Date(Date.parse(day(now)+'T12:00:00Z')-offset*86400000).toISOString().slice(0,10);
+export function recordPublicGet(request,env,ctx,now=new Date()) {
+ const page=publicPages[new URL(request.url).pathname];
+ if(request.method!=='GET'||!page||!env.BUCKET||typeof ctx?.waitUntil!=='function')return;
+ // Deliberately do not retain query strings, headers, IP, referrer or customer data.
+ ctx.waitUntil(Promise.resolve().then(async()=>{
+  const dailyPrefix=prefix+day(now)+'/';
+  const existing=await env.BUCKET.list({prefix:dailyPrefix,limit:1000});
+  if(existing.truncated||existing.objects.length>=1000)return;
+  await env.BUCKET.put(`${dailyPrefix}${page}/${crypto.randomUUID()}`, '1',
+   {httpMetadata:{contentType:'text/plain'}});
+ }).catch(()=>{}));
+}
+export async function summarizePublicGets(bucket,now=new Date()) {
+ const days=[];
+ for(let i=0;i<7;i++){
+  const date=offsetDay(now,i);
+  const listing=await bucket.list({prefix:prefix+date+'/',limit:1000});
+  const counts=Object.fromEntries(Object.values(publicPages).map(page=>[page,0]));
+  for(const {key} of listing.objects){
+   const suffix=key.slice((prefix+date+'/').length),[page,id,...extra]=suffix.split('/');
+   if(Object.hasOwn(counts,page)&&/^[a-f0-9-]{36}$/.test(id??'')&&!extra.length)counts[page]++;
+  }
+  days.push({date,counts,truncated:listing.truncated===true||listing.objects.length>=1000});
+ }
+ // Best-effort bounded expiry on authorized reads, never on a customer response.
+ const cutoff=offsetDay(now,30);
+ const expired=await bucket.list({prefix,limit:100});let removed=0;
+ for(const {key} of expired.objects){
+  const date=key.slice(prefix.length,prefix.length+10);
+  if(/^\d{4}-\d{2}-\d{2}$/.test(date)&&date<cutoff){await bucket.delete(key);removed++;}
+ }
+ return {schemaVersion:1,observedAt:now.toISOString(),timeZone:'Europe/Zurich',days,
+  cleanup:{removed,maxPerRead:100,retention:'Expired anonymous events are removed opportunistically after 30 days; deletion may lag.'},
+  limitations:['Successful-storage public page GET events only, not unique visitors or browser views.',
+   'Includes bots, repeated requests and verification traffic; excludes upstream cache hits and failed writes.',
+   'Recording stops at an observed 1000-event daily cap; concurrent writes can overshoot. Reads include only the first 1000 events; saturated totals are lower bounds.',
+   'Seven calendar days including the incomplete current day. No historical backfill or visitor conversion rate.']};
+}
